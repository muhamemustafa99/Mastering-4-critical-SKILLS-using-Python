# Read the number
number = int(input("Enter a number: "))

# This variable stores the reversed number as we build it
reversed_number = 0

# Continue until there are no digits left
while number > 0:

    # Extract the last digit
    last_digit = number % 10

    # Remove the last digit from the remaining number
    number //= 10

    # Shift the reversed number left and append the extracted digit
    reversed_number = (reversed_number * 10) + last_digit

print("Reversed Number :", reversed_number)
print("Reversed × 3    :", reversed_number * 3)

